# Copy to .env.local and fill in. Never commit it.
#
# One file serves both halves: Next.js reads .env and .env.local natively,
# and the Python fetcher (flighttracker/config.py) reads the same two.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development: `docker compose up -d` starts a throwaway Postgres on
# 5546 (5432 and the low ports are taken by the other projects on this host).
# Production: a dedicated database and user inside `postgres-shared` on the
# VPS — never the `postgres` superuser, so a compromise here cannot read
# other apps' data.
DATABASE_URL=postgresql://viajes:viajes@localhost:5546/viajes

# ---------------------------------------------------------------------------
# Chat assistant (optional)
# ---------------------------------------------------------------------------
# The whole app works without these; only "Preguntar a la IA" needs one.
# Get a Gemini key at https://aistudio.google.com/apikey. Gemini wins if both
# are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Alerting (optional)
# ---------------------------------------------------------------------------
# Any endpoint that accepts a JSON body. When a fetch run has a failed or
# suspect provider attempt, one message is posted here. Unset means the
# failures still reach stderr and `python -m flighttracker runs`; alerting is
# quieter without it, never silent.
ALERT_WEBHOOK_URL=
