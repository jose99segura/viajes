# The fetcher: the original `flighttracker` package, writing into Postgres.
#
# This stays Python because providers/google.py depends on `fast-flights`,
# which speaks Google's own protobuf protocol. There is no TypeScript
# equivalent, and it is the only source of Google data for LUX. Rewriting it
# means reimplementing that encoding — easy to get subtly wrong, and the
# providers are the part of this project that already works.
#
# slim rather than alpine: several of these dependencies ship manylinux
# wheels and no musl ones, so alpine would compile them from source on a VPS
# that is already short of CPU.

FROM python:3.12-slim

# The providers talk HTTPS to ryanair.com, luxair.lu and Google. ca-certificates
# is not in the slim image, and without it every fetch fails verification.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates tzdata \
 && rm -rf /var/lib/apt/lists/*

# Departures are stored as local wall clocks, but `captured_at` is a real
# instant and the alert check compares against "today". Pin the zone rather
# than inherit whatever the host has.
ENV TZ=Europe/Luxembourg
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Cached unless the dependency list changes, which is rarely.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY flighttracker ./flighttracker
COPY config.yaml ./config.yaml
COPY scripts ./scripts

# Never run as root.
RUN useradd --system --uid 1001 --create-home fetcher \
 && chown -R fetcher:fetcher /app
USER fetcher

# The container idles and Coolify's Scheduled Task runs the fetch inside it
# (see docs/deployment.md). A scheduled task is a `docker exec`, so something
# has to be running for it to exec into. An idle Python container costs a few
# MB and no CPU, and it keeps the schedule visible in Coolify's UI rather
# than buried in a crontab inside the image.
CMD ["sleep", "infinity"]
