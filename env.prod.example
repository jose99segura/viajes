# Coolify → viajes:master → Environment Variables.
#
# Paste these in, then fill the two <...> placeholders. Committed as an
# example only: the real file is `env.prod`, which .gitignore keeps out.
#
# Hostname `yhnvfpxjld6w2dthn71qgcwl` is the postgres-shared CONTAINER NAME,
# which is also its DNS name on the `coolify` network (10.0.1.7 today). It
# resolves only if "Connect to predefined network" is ON for this resource —
# without it the app boots clean and only the healthcheck fails, silently.
DATABASE_URL=postgresql://viajes_prod:<password>@yhnvfpxjld6w2dthn71qgcwl:5432/viajes_prod

# Optional. The app runs without them; only the "Preguntar a la IA" panel
# needs one, and it says so when there is none. Gemini wins if both are set.
GEMINI_API_KEY=<your gemini key, or leave empty>
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Remove these three, left over from the Flask deployment
# ---------------------------------------------------------------------------
# FETCH_INTERVAL   — the fetcher is a Coolify Scheduled Task now, not a loop.
# SERVICE_FQDN_WEB — duplicated in the current config; Coolify re-creates the
# SERVICE_URL_WEB    pair itself from the domain assigned to the `web` service.
